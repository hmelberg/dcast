    arrow a_merge n_muni -> n_pers curved #2f6b8f hidden true
    label l_merge "merge" below #2f6b8f attach_to a_merge font_size 22 hidden true
    box n_gap "gap mellom personer" #2f6b8f x 230 y 260 width 340 height 90 hidden true
    arrow a_right n_pers -> n_gap #2f6b8f hidden true
