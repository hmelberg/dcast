    shape raw_sq #3d3833 cites ["finkelstein2012"] shape rect x 493.5 y 560 width 30 height 30 style.fill #3d3833 hidden true
    text raw_val "−2.3" #3d3833 cites ["finkelstein2012"] x 493.5 y 610 font_size 40 hidden true
    text ctl_name "With controls" #3d3833 x 190 y 430 font_size 42 hidden true
    path ctl_ci #3d3833 cites ["finkelstein2012"] points [[592,430],[661,430]] style.stroke_width 5 hidden true
    shape ctl_sq #3d3833 cites ["finkelstein2012"] shape rect x 626.4 y 430 width 30 height 30 style.fill #3d3833 hidden true
    text ctl_val "−0.9" #3d3833 cites ["finkelstein2012"] x 626.4 y 480 font_size 40 hidden true
