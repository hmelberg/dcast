    curve cov_l #2f6b8f expr "86 + 0.4*(x-60)" x_from 59.6 x_to 65 style.stroke_width 5 hidden true
    curve cov_r #2f6b8f expr "97.5 + 0.15*(x-65)" x_from 65 x_to 70.5 style.stroke_width 5 hidden true
    text r_left "87.9 %" #2f6b8f at.data [62.6,90.2] cites ["cdm2008"] font_size 40 hidden true
