    axes ax hidden true
    text yl "Dies within a week, %" #3d3833 at.data [61.5,6.85] font_size 32 hidden true
    text y3 "3" #8f887c at.data [58.85,3] font_size 32 hidden true
    text y4 "4" #8f887c at.data [58.85,4] font_size 32 hidden true
