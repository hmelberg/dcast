    text r2_qt "?" #8f887c x 960 y 495 font_size 62 hidden true
    text r3_name "Rosa" x 150 y 415 font_size 50 hidden true
    text r3_d "1" x 360 y 415 font_size 56 hidden true
    text r3_y1 "18" #2f6b8f x 560 y 415 font_size 56 hidden true
    text r3_y0 "15" #b5482e x 760 y 415 font_size 56 hidden true
    text r3_t "3" #8a5fa8 x 960 y 415 font_size 56 hidden true
    text r3_q "?" #8f887c x 760 y 415 font_size 62 hidden true
    text r3_qt "?" #8f887c x 960 y 415 font_size 62 hidden true
    text r4_name "Daniel" x 150 y 335 font_size 50 hidden true
    text r4_d "0" x 360 y 335 font_size 56 hidden true
    text r4_y1 "29" #2f6b8f x 560 y 335 font_size 56 hidden true
    text r4_y0 "25" #b5482e x 760 y 335 font_size 56 hidden true
    text r4_t "4" #8a5fa8 x 960 y 335 font_size 56 hidden true
    text r4_q "?" #8f887c x 560 y 335 font_size 62 hidden true
    text r4_qt "?" #8f887c x 960 y 335 font_size 62 hidden true
