    text avg_lab "Average" x 150 y 235 font_size 46 hidden true
    text avg_y1 "25" #2f6b8f x 560 y 235 font_size 56 hidden true
    text avg_y0 "21" #b5482e x 760 y 235 font_size 56 hidden true
    text avg_t "4" #8a5fa8 x 960 y 235 font_size 62 hidden true
