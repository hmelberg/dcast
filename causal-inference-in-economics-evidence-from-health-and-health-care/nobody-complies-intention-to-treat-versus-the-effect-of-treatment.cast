    curve rise #4f8a4b expr L*x/100 style.stroke_width 4 hidden true
    text lab_itt "winners minus losers" #4f8a4b at.data [88,21.5] font_size 32 hidden true
    dot itt_pt #4f8a4b at.on rise at.x 30 guides true bind {"at.x":"s"} drag s hidden true
