*sin(88.81*ln(x))/(88.81*ln(x))*min(max(N-24,0),1)-2*sqrt(x)*sin(92.49*ln(x))/(92.49*ln(x))*min(max(N-25,0),1)-2*sqrt(x)*sin(94.65*ln(x))/(94.65*ln(x))*min(max(N-26,0),1)-2*sqrt(x)*sin(95.87*ln(x))/(95.87*ln(x))*min(max(N-27,0),1)-2*sqrt(x)*sin(98.83*ln(x))/(98.83*ln(x))*min(max(N-28,0),1)-2*sqrt(x)*sin(101.32*ln(x))/(101.32*ln(x))*min(max(N-29,0),1) x_from 2 x_to 1000 cites ["riemann"] details "Riemann's explicit formula: $$\\pi(x) \\approx \\mathrm{li}(x) - \\tfrac{1}{2}\\mathrm{li}(\\sqrt{x}) - \\sum_\\rho \\mathrm{li}(x^\\rho)$$ Each pair of zeros $\\tfrac12 \\pm i\\gamma$ adds a wave of about $-2\\sqrt{x}\\,\\sin(\\gamma\\ln x)/(\\gamma\\ln x)$; drawn here with the first 30 pairs." style.stroke_width 2 hidden true
